generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  category    String   @default("Geral")
  description String?
  price       Float
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              Int         @id @default(autoincrement())
  customerName    String
  customerEmail   String
  address         String
  total           Float
  paymentMethod   String      @default("credit_card")
  paymentStatus   String      @default("pending")
  installmentCount Int        @default(1)
  installmentValue Float      @default(0)
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id])
  productId   Int
  productName String
  productSlug String
  productImage String?
  unitPrice   Float
  quantity    Int
}